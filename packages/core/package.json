{
  "name": "@continuity/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "test:pglite": "CONTINUITY_TEST_BACKEND=pglite vitest run --maxWorkers=3",
    "test:pg": "CONTINUITY_TEST_BACKEND=postgres vitest run --maxWorkers=3",
    "db:generate:pg": "drizzle-kit generate --config drizzle.pg.config.ts && sed -i 's/REFERENCES \"public\"\\./REFERENCES /g' drizzle-pg/*.sql"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "better-sqlite3": "^13.2.0",
    "drizzle-orm": "^0.45.4",
    "postgres": "^3.4.9",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
